# =============================================================================
# cosmac MCP-server Docker image — stdio transport, no HTTP surface
# =============================================================================
#
# This is a separate image from the default Dockerfile (which runs the
# REST/uvicorn server). Use this one when you want the bundled MCP server
# (`cosmac-mcp`), for example:
#
#   * Registry submissions to Glama / Smithery / MCP.so
#   * Docker-based MCP clients (Claude Desktop / Cursor / VS Code) that
#     shell out to a Docker container instead of a local venv
#   * Self-hosted MCP-tool sidecars in agent deployments
#
# The default Dockerfile stays as-is so existing deployers of the REST API
# are unaffected.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build — install cosmac with the [mcp] extra
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

# System deps needed for building wheels (regex, pydantic-core, etc.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency metadata + source
COPY pyproject.toml ./
COPY src/ ./src/

# Install with the [mcp] extra (pulls mcp>=1.10 + anyio) into a prefix
# that we can copy into the runtime stage.
RUN pip install --no-cache-dir --prefix=/install ".[mcp]"

# ---------------------------------------------------------------------------
# Stage 2: Runtime — lean stdio-only image
# ---------------------------------------------------------------------------
FROM python:3.12-slim

# --- OCI / opencontainers labels -------------------------------------------
LABEL maintainer="cosmac contributors" \
      version="0.7.6" \
      description="cosmac MCP server (stdio) for LLM applications" \
      org.opencontainers.image.title="cosmac-mcp" \
      org.opencontainers.image.description="Standalone MCP server exposing cosmac's scan API to Claude Desktop / Cursor / VS Code / n8n over stdio" \
      org.opencontainers.image.version="0.7.6" \
      org.opencontainers.image.licenses="Apache-2.0"

# Copy installed Python packages from builder stage.
COPY --from=builder /install /usr/local

# --- Non-root user (security best practice) ---------------------------------
RUN groupadd --gid 1000 shield && \
    useradd --uid 1000 --gid shield --create-home shield

# Data directory for SQLite (audit trail) + vault caches.
RUN mkdir -p /home/shield/data && chown -R shield:shield /home/shield/data

USER shield
WORKDIR /home/shield

# --- Environment variables ---------------------------------------------------
# The MCP server auto-loads its bundled interactive-assistant profile
# (mode: monitor, advisory findings only) when COSMAC_CONFIG is
# unset — no need to force mode/threshold here.
ENV COSMAC_DATA_DIR=/home/shield/data \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# --- No EXPOSE, no HEALTHCHECK ----------------------------------------------
# The MCP protocol runs over stdio (JSON-RPC on stdin/stdout, logs on
# stderr). Nothing to expose over TCP; nothing to health-check with curl.
# Clients (Glama, Smithery, Claude Desktop) invoke:
#   docker run --rm -i cosmac-mcp
# and speak MCP directly through the container's stdin/stdout streams.

# --- Entrypoint --------------------------------------------------------------
ENTRYPOINT ["python", "-m", "cosmac.mcp_server"]
